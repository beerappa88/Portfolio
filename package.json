{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio site — React front end with a serverless contact form",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
    "build": "npm install --prefix client && npm run build --prefix client",
    "test": "npm test --prefix client -- --watchAll=false",
    "lint": "eslint api server.js"
  },
  "author": "beerappa",
  "license": "MIT",
  "dependencies": {
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "express": "^4.19.2",
    "nodemon": "^3.1.4"
  }
}
