# Copy to .env and fill in real values. Never commit .env.
# In production these are set in the Vercel dashboard
# (Project → Settings → Environment Variables), not from this file.

# Local dev API server port. CRA proxies /api/* here — if you change this,
# update "proxy" in client/package.json to match. Not used on Vercel.
PORT=8080

# SMTP credentials for the contact form.
# Gmail: use an App Password (https://myaccount.google.com/apppasswords),
# not your account password — regular passwords are rejected.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password

# Address the notification is sent FROM. Most providers require this to
# match SMTP_USERNAME or a verified sender.
SMTP_FROM_EMAIL=you@example.com

# Where contact-form messages land. Defaults to SMTP_FROM_EMAIL if unset.
CONTACT_TO_EMAIL=you@example.com
